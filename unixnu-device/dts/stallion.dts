/dts-v1/;

/*
 * Google Pixel 10a (stallion), Google Tensor G4 (zumapro).
 *
 * Every value here was read from this phone, either from its own device tree
 * or from its registers by our firmware. Nothing is carried over from a
 * similar board, because two Tensor phones differ in exactly the places that
 * matter.
 */

/ {
    model = "Google Pixel 10a";
    compatible = "google,stallion", "google,zumapro";

    #address-cells = <2>;
    #size-cells = <2>;

    chosen {
    };

    /*
     * Eight cores, started through the secure monitor. The stock tree lists
     * no hvc method and the firmware already reaches EL3 this way.
     */
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };

    cpus {
        #address-cells = <2>;
        #size-cells = <0>;

        /*
         * 24.576 MHz, from the stock timer node's clock-frequency of
         * 0x1770000. Not the 19.2 MHz that Qualcomm boards use, and a wrong
         * value here makes every timeout in the kernel wrong by a quarter.
         */
        timebase-frequency = <24576000>;

        /*
         * Affinity values and core types come from the stock tree. The four
         * at capacity 193 are the efficiency cores, the three at 927 and the
         * one at 1024 are the performance cores. The first entry is the boot
         * core.
         */
        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a520";
            reg = <0x0 0x000>;
            unixnu,cluster-type = "E";
            status = "okay";
        };

        cpu@100 {
            device_type = "cpu";
            compatible = "arm,cortex-a520";
            reg = <0x0 0x100>;
            unixnu,cluster-type = "E";
            status = "okay";
        };

        cpu@200 {
            device_type = "cpu";
            compatible = "arm,cortex-a520";
            reg = <0x0 0x200>;
            unixnu,cluster-type = "E";
            status = "okay";
        };

        cpu@300 {
            device_type = "cpu";
            compatible = "arm,cortex-a520";
            reg = <0x0 0x300>;
            unixnu,cluster-type = "E";
            status = "okay";
        };

        cpu@400 {
            device_type = "cpu";
            compatible = "arm,cortex-a720";
            reg = <0x0 0x400>;
            unixnu,cluster-type = "P";
            status = "okay";
        };

        cpu@500 {
            device_type = "cpu";
            compatible = "arm,cortex-a720";
            reg = <0x0 0x500>;
            unixnu,cluster-type = "P";
            status = "okay";
        };

        cpu@600 {
            device_type = "cpu";
            compatible = "arm,cortex-a720";
            reg = <0x0 0x600>;
            unixnu,cluster-type = "P";
            status = "okay";
        };

        cpu@700 {
            device_type = "cpu";
            compatible = "arm,cortex-x4";
            reg = <0x0 0x700>;
            unixnu,cluster-type = "P";
            status = "okay";
        };
    };

    /*
     * One contiguous range, and deliberately not all of the memory.
     *
     * This phone has 8 GiB in four banks: 2 GiB at 0x80000000 and three more
     * at 0x880000000, 0x900000000 and 0x980000000. The kernel maps the whole
     * range it is given as ordinary cacheable memory, so the range must hold
     * no vendor carve-out. Every reservation in the stock tree, the
     * bootloader's own region, the debug buffers and the framebuffer among
     * them, sits in the low bank. The three high banks are adjacent and
     * clean, so they are handed over as one 6 GiB block and the low bank is
     * left alone.
     */
    memory@880000000 {
        device_type = "memory";
        reg = <0x8 0x80000000 0x1 0x80000000>;
        status = "okay";
    };

    soc {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        /*
         * Interrupt controller, from the stock tree's own node. The
         * redistributor window is 2 MiB across eight cores, so each core's
         * frame is 256 KiB rather than the 128 KiB of a plain GICv3. A
         * redistributor window described too small leaves the secondary
         * cores unable to start.
         */
        interrupt-controller@10400000 {
            unixnu,adt-name = "intc";
            compatible = "arm,gic-v3";
            interrupt-controller;
            #interrupt-cells = <4>;
            reg = <0x0 0x10400000 0x0 0x00010000>,
                  <0x0 0x10440000 0x0 0x00200000>;
            redistributor-stride = <0x0 0x00040000>;
            status = "okay";
        };
    };

    /*
     * The buffer the panel is scanned out of. Our firmware draws here and
     * the display controller fetches it continuously, so nothing may reuse
     * it. The kernel learns the geometry from the graphics protocol at
     * handover, not from here.
     */
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        framebuffer@fac00000 {
            reg = <0x0 0xfac00000 0x0 0x00a00000>;
            no-map;
        };
    };
};
